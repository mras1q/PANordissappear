#include <iostream>
#include <vector>
#include <algorithm>
#include <iomanip>

int main() {
    double v0 = 50.0, g = 9.8, dt = 1.0, t_end = 12.0;

    std::vector<double> times, heights;
    for (double t = 0.0; t <= t_end; t += dt) {
        times.push_back(t);
        heights.push_back(v0 * t - 0.5 * g * t * t);
    }

    auto it = std::find_if(heights.begin() + 1, heights.end(),
                           [](double h) { return h <= 0.0; });

    if (it == heights.end()) {
        std::cout << "Падения в диапазоне не было\n";
    } else {
        size_t idx = std::distance(heights.begin(), it);
        double t_fall = times[idx];
        std::cout << std::fixed << std::setprecision(2);
        std::cout << "t_fall = " << t_fall << " с, h = " << heights[idx] << " м\n";
        std::cout << "(точное значение 2*v0/g = " << 2 * v0 / g << " с)\n";
    }
    return 0;
}
