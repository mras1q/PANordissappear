#include <iostream>
#include <iomanip>

class FlightComputer {
private:
    double altitude;
    double velocity;
    double fuel;
    double thrust;

public:
    FlightComputer(double alt, double vel, double f, double th)
        : altitude(alt), velocity(vel), fuel(f), thrust(th) {}

    void simulateStep(double dt) {
        velocity += (thrust / 1000.0 - 9.8) * dt;
        altitude += velocity * dt;
        fuel -= dt * 2;
        if (fuel < 0) fuel = 0;
    }

    void printStatus() const {
        std::cout << std::fixed << std::setprecision(1)
                  << "высота=" << altitude << " м, скорость=" << velocity
                  << " м/с, топливо=" << fuel << "\n";
    }
};

int main() {
    FlightComputer fc(0, 0, 100, 12000);
    for (int i = 0; i < 5; i++) {
        fc.simulateStep(0.5);
        fc.printStatus();
    }
    return 0;
}
