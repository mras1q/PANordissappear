#include <iostream>
#include <vector>
#include <iomanip>

int main() {
    double v0 = 50.0, g = 9.8, dt = 1.0;
    std::vector<double> times, heights;
    for (double t = 0.0; t <= 1000.0; t += dt) {
        double h = v0 * t - 0.5 * g * t * t;
        if (h < 0) break;
        times.push_back(t);
        heights.push_back(h);
    }

    if (heights.empty()) {
        std::cout << "Данных нет\n";
        return 0;
    }

    size_t idx_max = 0;
    for (size_t i = 1; i < heights.size(); ++i)
        if (heights[i] > heights[idx_max]) idx_max = i;

    std::cout << std::fixed << std::setprecision(2);
    std::cout << "Максимальная высота: " << heights[idx_max]
              << " м при t = " << times[idx_max] << " с\n";

    // Тест на плато
    std::vector<double> plateau = {1, 5, 9, 9, 3};
    size_t p = 0;
    for (size_t i = 1; i < plateau.size(); ++i)
        if (plateau[i] > plateau[p]) p = i;
    std::cout << "Плато {1,5,9,9,3}: индекс = " << p << " (первый максимум)\n";
    return 0;
}
